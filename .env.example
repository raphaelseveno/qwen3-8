# OpenHands browser UI: http://localhost:3000
OPENHANDS_PORT=3000

# Gateway policy: stop GPU 10 minutes after the last completed response.
IDLE_MINUTES=10
SKY_CLUSTER=qwen-coding
MODEL_ID=qwen3.8-27b-obliterated-q8

# Optional, strongly recommended after publishing the prebuilt image below.
# Example: MODEL_SERVER_IMAGE=docker.io/your-dockerhub-user/qwen3-8-llama:cuda
# This removes the CUDA llama.cpp compilation from every brand-new GPU wake.
MODEL_SERVER_IMAGE=

# No model credentials are required. The server downloads the public GGUF from
# Hugging Face with a parallel, resumable downloader on first use.
